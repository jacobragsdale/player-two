{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Player Two",
  "identifier": "io.github.jacobragsdale.player-two",
  "build": {
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM5RUE0RUEyMTgyMUU1REEKUldUYTVTRVlvazdxT1Zza1BLSVhvaEVWUTgvZFZrdXdDVDFvbzNsV09ZZForSGVMRkdscUNkdmMK",
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": { "type": "skip" },
      "nsis": { "installMode": "currentUser" }
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
